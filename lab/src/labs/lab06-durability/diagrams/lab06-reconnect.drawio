<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab06 Reconnect">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="Lab 06 — One broker restart, line by line (real log from this lab)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1290" height="40" as="geometry" /></mxCell>
<mxCell id="h1" value="log line" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="600" height="44" as="geometry" /></mxCell>
<mxCell id="h2" value="what it means" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="690" height="44" as="geometry" /></mxCell>
<mxCell id="l0" value="⏳ invoice #2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w0" value="The handler starts. It will take 3 seconds." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="124" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l1" value="ERROR Disconnected: 320 CONNECTION-FORCED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="194" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w1" value="The TCP connection is gone. &lt;b&gt;Every channel on it died at the same instant&lt;/b&gt;, including the one that delivered invoice #2." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="194" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l2" value="WARN Reconnect attempt #1 in 476 ms" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="264" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w2" value="amqplib&#x27;s own recovery, with backoff + jitter: 0.5s → 1s → 2s → 4s … capped at 10s. You write none of this." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="264" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l3" value="POST /lab06/invoices  →  503" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="334" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w3" value="getChannel() has no channel, so it throws ServiceUnavailableException. An honest, retryable answer." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="334" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l4" value="❌ ack for #2 failed: Channel closed" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w4" value="The work FINISHED, but a deliveryTag only means something on the channel that delivered it. That channel no longer exists." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="404" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l5" value="⏳ invoice #2  (redelivered)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="474" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w5" value="No ack ever reached the broker, so it redelivers. &lt;b&gt;The same invoice is now processed a second time.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="474" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l6" value="Consumer &quot;lab06.invoices&quot; is running" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="544" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w6" value="Our setup() ran again on a NEW channel: assertExchange → assertQueue → bindQueue → prefetch → consume." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="544" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l7" value="Restored 1 consumer(s)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="614" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w7" value="One, not six. Labs 01–05 used createChannel() directly, so nobody brings them back." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="614" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="l8" value="✅ #2   ✅ #3   ✅ #4   ✅ #5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="684" width="600" height="70" as="geometry" /></mxCell>
<mxCell id="w8" value="Normal service. The queue kept the backlog the whole time." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="620" y="684" width="690" height="70" as="geometry" /></mxCell>
<mxCell id="foot" value="&lt;b&gt;amqplib recovered the connection. Your code recovered the work.&lt;/b&gt;&amp;nbsp; Between those two sits the duplicate: at-least-once delivery is the price of not losing messages, and the cure is an idempotent consumer (Lab 12), not a cleverer broker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="774" width="1290" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
