<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab06 What Recovers">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="What amqplib restores, and what you must restore yourself" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1240" height="40" as="geometry" /></mxCell>
<mxCell id="n0" value="&lt;b&gt;TCP connection&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;amqp.connect(url, { recovery })&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=16;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="420" height="86" as="geometry" /></mxCell>
<mxCell id="b0" value="✓ amqplib" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="450" y="90" width="170" height="86" as="geometry" /></mxCell>
<mxCell id="y0" value="amqplib reopens the socket, handshakes and retries with backoff." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="620" height="86" as="geometry" /></mxCell>
<mxCell id="n1" value="&lt;b&gt;channels&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;connection.createChannel()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=16;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="420" height="86" as="geometry" /></mxCell>
<mxCell id="b1" value="✗ your job" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="186" width="170" height="86" as="geometry" /></mxCell>
<mxCell id="y1" value="Channels are not re-opened. Every old channel object is permanently dead." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="640" y="186" width="620" height="86" as="geometry" /></mxCell>
<mxCell id="n2" value="&lt;b&gt;consumers&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;channel.consume(...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=16;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="282" width="420" height="86" as="geometry" /></mxCell>
<mxCell id="b2" value="✗ your job" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="282" width="170" height="86" as="geometry" /></mxCell>
<mxCell id="y2" value="A consumer lives on a channel. No channel, no consumer — and no error either, just silence." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="640" y="282" width="620" height="86" as="geometry" /></mxCell>
<mxCell id="n3" value="&lt;b&gt;topology&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;assertExchange / assertQueue / bindQueue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=16;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="378" width="420" height="86" as="geometry" /></mxCell>
<mxCell id="b3" value="✗ your job" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="450" y="378" width="170" height="86" as="geometry" /></mxCell>
<mxCell id="y3" value="Transient exchanges, queues and their bindings are gone after a broker restart. Re-declare all of it." style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=14;fillColor=#ffffff;strokeColor=#d0d0d0;" vertex="1" parent="1"><mxGeometry x="640" y="378" width="620" height="86" as="geometry" /></mxCell>
<mxCell id="bridge" value="&lt;b&gt;registerConsumer(name, setup)&lt;/b&gt; is the bridge: the service keeps every setup function and re-runs it on a fresh channel after each reconnect." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="20" y="484" width="1240" height="50" as="geometry" /></mxCell>
<mxCell id="c1" value="&lt;b&gt;Labs 01–05&lt;/b&gt; — createChannel() once, in onModuleInit()&lt;br&gt;&lt;br&gt;After the restart: publishing works again (201), but the queue shows&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;notifications&amp;nbsp;&amp;nbsp;1 message&amp;nbsp;&amp;nbsp;&lt;b&gt;0 consumers&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Messages pile up and nothing reads them. No crash, no log." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=16;verticalAlign=top;spacingTop=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="554" width="620" height="140" as="geometry" /></mxCell>
<mxCell id="c2" value="&lt;b&gt;Lab 06&lt;/b&gt; — registerConsumer(), setup re-runs&lt;br&gt;&lt;br&gt;After the restart:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;lab06.invoices.durable&amp;nbsp;&amp;nbsp;0 messages&amp;nbsp;&amp;nbsp;&lt;b&gt;1 consumer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The backlog is drained, starting with the redelivered one." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=16;verticalAlign=top;spacingTop=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="554" width="600" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
