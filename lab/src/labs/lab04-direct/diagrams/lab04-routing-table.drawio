<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab04 Routing Table">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 04 — Direct: the exchange is a lookup, not a photocopier" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pub" value="&lt;b&gt;Lab04Controller&lt;/b&gt;&lt;br&gt;POST /lab04/publish&lt;br&gt;{ &quot;key&quot;: &quot;order.paid&quot; }&lt;br&gt;&lt;br&gt;publish(exchange, &lt;b&gt;'order.paid'&lt;/b&gt;, buf)&lt;br&gt;&lt;i&gt;still knows NO queue&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="245" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="RabbitMQ broker" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="920" height="470" as="geometry" />
        </mxCell>

        <mxCell id="ex" value="&lt;b&gt;lab04.orders.direct&lt;/b&gt;&lt;br&gt;type: &lt;b&gt;direct&lt;/b&gt;&lt;br&gt;&lt;br&gt;bindingKey === routingKey&lt;br&gt;&lt;i&gt;exact string, case sensitive&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="broker">
          <mxGeometry x="25" y="170" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="thead" value="BINDING TABLE  ·  key → queue" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;spacingLeft=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="broker">
          <mxGeometry x="265" y="52" width="350" height="34" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="&lt;b&gt;order.paid&lt;/b&gt; → lab04.warehouse   ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="broker">
          <mxGeometry x="265" y="94" width="350" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;order.paid&lt;/b&gt; → lab04.email   ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="broker">
          <mxGeometry x="265" y="146" width="350" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="order.cancelled → lab04.email   ✗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;" vertex="1" parent="broker">
          <mxGeometry x="265" y="198" width="350" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;order.paid&lt;/b&gt; → lab04.audit   ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="broker">
          <mxGeometry x="265" y="250" width="350" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="order.created → lab04.audit   ✗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;" vertex="1" parent="broker">
          <mxGeometry x="265" y="302" width="350" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="order.created → lab04.analytics   ✗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;" vertex="1" parent="broker">
          <mxGeometry x="265" y="354" width="350" height="46" as="geometry" />
        </mxCell>

        <mxCell id="qw" value="&lt;b&gt;lab04.warehouse&lt;/b&gt;&lt;br&gt;1 copy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="665" y="85" width="215" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qe" value="&lt;b&gt;lab04.email&lt;/b&gt;&lt;br&gt;1 copy — not 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="665" y="163" width="215" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qa" value="&lt;b&gt;lab04.audit&lt;/b&gt;&lt;br&gt;1 copy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="665" y="267" width="215" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qn" value="&lt;b&gt;lab04.analytics&lt;/b&gt;&lt;br&gt;nothing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#999999;" vertex="1" parent="broker">
          <mxGeometry x="665" y="345" width="215" height="64" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Read the table twice:&lt;/b&gt;&lt;br&gt;3 rows matched → 3 queues → 3 copies.&lt;br&gt;&lt;br&gt;lab04.email has TWO bindings, but only ONE of them matched this key — and even if both had matched, the queue would still get ONE message. &lt;b&gt;The queue is the unit of copying, not the binding.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="takeaway" value="&lt;b&gt;fanout:&lt;/b&gt; copy to every bound queue.&amp;nbsp; &lt;b&gt;direct:&lt;/b&gt; copy to every queue whose binding key is EXACTLY equal to the routing key.&lt;br&gt;Same key on 3 queues = 3 copies (direct can behave like fanout). No matching row = the message is dropped before it ever reaches a queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="575" width="1200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="ex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9673a6;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="thead">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="555" y="340" />
              <mxPoint x="555" y="179" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="qw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="qe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b3b3b3;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="qe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b3b3b3;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5" target="qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b3b3b3;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r6" target="qn">
