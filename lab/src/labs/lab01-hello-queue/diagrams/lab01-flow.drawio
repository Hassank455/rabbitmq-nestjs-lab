<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab01 Flow">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 01 — Hello Queue: the full message flow" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="client" value="&lt;b&gt;curl / Postman&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="endnote" value="HTTP 200 comes back right after publishing.&lt;br&gt;&lt;b&gt;The request ENDS at the controller.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="nest" value="NestJS app  (lab/)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;Lab01Controller&lt;/b&gt;&lt;br&gt;POST /lab01/publish&lt;br&gt;sendToQueue()&lt;br&gt;&lt;i&gt;PRODUCER&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="nest">
          <mxGeometry x="30" y="70" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cons" value="&lt;b&gt;Lab01Consumer&lt;/b&gt;&lt;br&gt;consume() callback&lt;br&gt;channel.ack(msg)&lt;br&gt;&lt;i&gt;CONSUMER&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="nest">
          <mxGeometry x="30" y="290" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;RabbitMQService&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 TCP connection&lt;br&gt;(amqp.connect)&lt;br&gt;&lt;br&gt;1 channel&lt;br&gt;(createChannel)&lt;br&gt;&lt;br&gt;port 5672" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="nest">
          <mxGeometry x="290" y="70" width="160" height="300" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="RabbitMQ broker  (Docker)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="500" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ex" value="&lt;b&gt;Default exchange&lt;/b&gt;&lt;br&gt;name: &amp;quot;&amp;quot;&lt;br&gt;type: direct" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="broker">
          <mxGeometry x="20" y="70" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q" value="&lt;b&gt;Queue: notifications&lt;/b&gt;&lt;br&gt;durable: false&lt;br&gt;[msg] [msg] [msg]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="300" y="70" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bnote" value="Every message passes through an exchange. The default exchange is bound automatically to every queue, using the queue name as the key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="broker">
          <mxGeometry x="20" y="170" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="takeaway" value="Producer and consumer never know each other. The only contract between them: queue name + message shape." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="ctrl">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-12" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="200 OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="client">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="12" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1333;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="publish('', 'notifications', buf)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="ex">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-16" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="binding key =&lt;br&gt;notifications&lt;br&gt;(automatic)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="q">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-30" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="broker PUSHES the message (consume = subscription)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8667;entryDx=0;entryDy=0;" edge="1" parent="1" source="q" target="svc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1230" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.8667;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="cons">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="channel.ack(msg)  →  broker deletes the message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;fontColor=#2d6a2d;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cons" target="q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="365" y="540" />
              <mxPoint x="1284" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
