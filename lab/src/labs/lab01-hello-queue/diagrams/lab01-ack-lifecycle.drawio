<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab01 ACK Lifecycle">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 01 — The life of one message (manual ack)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pub" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;sendToQueue()" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;waiting in the queue&lt;br&gt;&lt;i&gt;UI column: Ready&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="unacked" value="&lt;b&gt;UNACKED&lt;/b&gt;&lt;br&gt;delivered, consumer working&lt;br&gt;&lt;i&gt;UI column: Unacked&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="deleted" value="&lt;b&gt;DELETED&lt;/b&gt;&lt;br&gt;gone from the broker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="190" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="broker pushes&lt;br&gt;to consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="unacked">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-22" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;channel.ack(msg)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontColor=#2d6a2d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="unacked" target="deleted">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="consumer crashes / Ctrl+C / connection lost&lt;br&gt;→ back to Ready, delivered again with &lt;b&gt;redelivered: true&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="unacked" target="ready">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="110" />
              <mxPoint x="350" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="noAck: true (auto-ack)  →  deleted the moment it is SENT  →  lost if the consumer crashes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ready" target="deleted">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="370" />
              <mxPoint x="990" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="footer" value="&lt;b&gt;Total = Ready + Unacked.&lt;/b&gt;&lt;br&gt;The crash → Ready loop is what gives RabbitMQ &lt;b&gt;at-least-once&lt;/b&gt; delivery.&lt;br&gt;Always ack AFTER the work succeeds. Ack too early and a crash loses the message. Never ack and it stays Unacked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1040" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
