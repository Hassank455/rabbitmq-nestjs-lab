<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab03 Lost vs Wait">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 03 — Lost, or waiting? It depends on the BINDING" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Panel A -->
        <mxCell id="pA" value="A · No queue bound yet → DROPPED" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="aPub" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;3 orders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pA">
          <mxGeometry x="20" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="aEx" value="&lt;b&gt;fanout&lt;/b&gt;&lt;br&gt;exchange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pA">
          <mxGeometry x="200" y="60" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="aDrop" value="&lt;b&gt;0 bindings&lt;/b&gt;&lt;br&gt;3 messages&lt;br&gt;DROPPED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="pA">
          <mxGeometry x="400" y="50" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aTxt" value="&lt;b&gt;Exchanges route. They do not store.&lt;/b&gt;&lt;br&gt;No queue is bound at publish time, so there is nowhere to put a copy.&lt;br&gt;Starting the consumers later does NOT bring orders #1 – #3 back.&lt;br&gt;&lt;i&gt;Experiment A&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="pA">
          <mxGeometry x="20" y="160" width="520" height="140" as="geometry" />
        </mxCell>

        <!-- Panel D -->
        <mxCell id="pD" value="D · Queue exists but is UNBOUND → no copy is made" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="dPub" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;3 orders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pD">
          <mxGeometry x="20" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dEx" value="&lt;b&gt;fanout&lt;/b&gt;&lt;br&gt;exchange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pD">
          <mxGeometry x="200" y="60" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dQ" value="&lt;b&gt;lab03.sms&lt;/b&gt;&lt;br&gt;Ready: 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pD">
          <mxGeometry x="400" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dC" value="&lt;b&gt;sms service&lt;/b&gt;&lt;br&gt;running&lt;br&gt;gets nothing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pD">
          <mxGeometry x="400" y="190" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dTxt" value="&lt;b&gt;The binding decides at PUBLISH time.&lt;/b&gt;&lt;br&gt;The queue exists and the service is running, but no binding means no copy.&lt;br&gt;Re-binding later does NOT backfill.&lt;br&gt;&lt;i&gt;Experiment D&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="pD">
          <mxGeometry x="20" y="140" width="350" height="170" as="geometry" />
        </mxCell>

        <!-- Panel E -->
        <mxCell id="pE" value="E · Bound, but the service is DOWN → messages WAIT" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ePub" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;3 orders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pE">
          <mxGeometry x="20" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eEx" value="&lt;b&gt;fanout&lt;/b&gt;&lt;br&gt;exchange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pE">
          <mxGeometry x="200" y="60" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eQ" value="&lt;b&gt;lab03.sms&lt;/b&gt;&lt;br&gt;Ready: 3 (waiting)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pE">
          <mxGeometry x="400" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eC" value="&lt;b&gt;sms service&lt;/b&gt;&lt;br&gt;STOPPED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pE">
          <mxGeometry x="400" y="190" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eTxt" value="&lt;b&gt;A bound queue is a mailbox.&lt;/b&gt;&lt;br&gt;A copy is made and stored even though nobody is consuming.&lt;br&gt;When the service starts, it receives all 3.&lt;br&gt;&lt;i&gt;Experiment E&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="pE">
          <mxGeometry x="20" y="140" width="350" height="170" as="geometry" />
        </mxCell>

        <!-- Panel F -->
        <mxCell id="pF" value="F · Exclusive queue → deleted with its connection" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="fPub" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;orders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pF">
          <mxGeometry x="20" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fEx" value="&lt;b&gt;fanout&lt;/b&gt;&lt;br&gt;exchange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pF">
          <mxGeometry x="200" y="60" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fQ" value="&lt;b&gt;amq.gen-XXXX&lt;/b&gt;&lt;br&gt;exclusive" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pF">
          <mxGeometry x="400" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fC" value="&lt;b&gt;DASH&lt;/b&gt;&lt;br&gt;Ctrl+C → queue gone" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pF">
          <mxGeometry x="400" y="190" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fTxt" value="&lt;b&gt;An exclusive queue dies with its connection.&lt;/b&gt;&lt;br&gt;The next start gets a NEW name. Orders published in between are gone.&lt;br&gt;Right for live views only.&lt;br&gt;&lt;i&gt;Experiment F&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="pF">
          <mxGeometry x="20" y="140" width="350" height="170" as="geometry" />
        </mxCell>

        <mxCell id="summary" value="&lt;b&gt;No binding&lt;/b&gt; → no copy → LOST        ·        &lt;b&gt;Binding + queue&lt;/b&gt; → copy stored → WAITS, even if nobody consumes        ·        &lt;b&gt;Exclusive queue&lt;/b&gt; → deleted on disconnect" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1160" height="60" as="geometry" />
        </mxCell>

        <!-- Edges A -->
        <mxCell id="aE1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPub" target="aEx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aE2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aEx" target="aDrop">
          <mxGeometry relative="1" as="geometry" />
