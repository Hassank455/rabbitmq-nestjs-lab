<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab03 Flow">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 03 — Fanout: one event, a copy for every bound queue" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pub" value="&lt;b&gt;Lab03Controller&lt;/b&gt;&lt;br&gt;POST /lab03/orders&lt;br&gt;assertExchange()&lt;br&gt;publish(exchange, '', buf)&lt;br&gt;&lt;i&gt;knows ONLY the exchange&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="RabbitMQ broker" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="560" height="640" as="geometry" />
        </mxCell>
        <mxCell id="bnote" value="Each arrow on the right is one &lt;b&gt;BINDING&lt;/b&gt;.&lt;br&gt;At publish time the exchange drops one copy into every bound queue.&lt;br&gt;The exchange itself stores nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="broker">
          <mxGeometry x="20" y="70" width="200" height="120" as="geometry" />
        </mxCell>
