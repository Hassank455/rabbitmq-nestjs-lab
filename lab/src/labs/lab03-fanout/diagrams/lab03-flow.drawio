        </mxCell>
        <mxCell id="qe" value="&lt;b&gt;lab03.email&lt;/b&gt;&lt;br&gt;named · durable: false" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
