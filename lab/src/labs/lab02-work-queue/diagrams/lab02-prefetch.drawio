<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab02 Prefetch">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 02 — prefetch: 20 tasks, one FAST worker and one SLOW worker" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Left: prefetch 0 -->
        <mxCell id="pL" value="PREFETCH = 0  (unlimited)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="540" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pubL" value="&lt;b&gt;Publisher&lt;/b&gt;&lt;br&gt;20 tasks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pL">
          <mxGeometry x="180" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="qL" value="&lt;b&gt;Queue: tasks&lt;/b&gt;&lt;br&gt;Ready: 0  |  Unacked: 20" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pL">
          <mxGeometry x="120" y="150" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fastL" value="&lt;b&gt;FAST worker&lt;/b&gt; (100 ms)&lt;br&gt;holds 10 messages&lt;br&gt;all 10 run at once&lt;br&gt;done in 0.1 s → then IDLE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pL">
          <mxGeometry x="30" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="slowL" value="&lt;b&gt;SLOW worker&lt;/b&gt; (3000 ms)&lt;br&gt;holds 10 messages&lt;br&gt;all 10 run at once&lt;br&gt;busy for 3 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pL">
          <mxGeometry x="290" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resL" value="&lt;b&gt;Blind round-robin at publish time → 10 / 10&lt;/b&gt;&lt;br&gt;in-flight per worker: no limit&lt;br&gt;Add W3 now: Ready = 0 → it gets nothing&lt;br&gt;Stuck worker: its 10 messages are held hostage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="pL">
          <mxGeometry x="20" y="430" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- Right: prefetch 1 -->
        <mxCell id="pR" value="PREFETCH = 1" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="540" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pubR" value="&lt;b&gt;Publisher&lt;/b&gt;&lt;br&gt;20 tasks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pR">
          <mxGeometry x="180" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="qR" value="&lt;b&gt;Queue: tasks&lt;/b&gt;&lt;br&gt;Ready: 18  |  Unacked: 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pR">
          <mxGeometry x="120" y="150" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fastR" value="&lt;b&gt;FAST worker&lt;/b&gt; (100 ms)&lt;br&gt;holds max 1&lt;br&gt;ack → gets the next one&lt;br&gt;processes ≈ 19" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pR">
          <mxGeometry x="30" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="slowR" value="&lt;b&gt;SLOW worker&lt;/b&gt; (3000 ms)&lt;br&gt;holds max 1&lt;br&gt;ack → gets the next one&lt;br&gt;processes ≈ 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="pR">
          <mxGeometry x="290" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resR" value="&lt;b&gt;Work flows to whoever is FREE → ≈ 19 / 1&lt;/b&gt;&lt;br&gt;in-flight per worker: exactly 1&lt;br&gt;Add W3 now: it takes from the 18 Ready at once&lt;br&gt;Stuck worker: only 1 message is held" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pR">
          <mxGeometry x="20" y="430" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="formula" value="&lt;b&gt;Max Unacked&lt;/b&gt; = consumers × prefetch&lt;br&gt;&lt;b&gt;In Node.js&lt;/b&gt;, prefetch = max concurrency, because amqplib never awaits your consume callback&lt;br&gt;&lt;b&gt;Throughput&lt;/b&gt; ≈ consumers × prefetch × (1000 / delayMs) messages per second&lt;br&gt;Call &lt;b&gt;channel.prefetch(N)&lt;/b&gt; BEFORE &lt;b&gt;channel.consume()&lt;/b&gt;. It only applies to consumers created after it." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;spacingLeft=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1140" height="110" as="geometry" />
        </mxCell>

        <!-- Edges left -->
        <mxCell id="eL0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubL" target="qL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eL1" value="10 pushed&lt;br&gt;immediately" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=3;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qL" target="fastL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eL2" value="10 pushed&lt;br&gt;immediately" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=3;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qL" target="slowL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges right -->
        <mxCell id="eR0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubR" target="qR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR1" value="1 at a time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qR" target="fastR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR2" value="1 at a time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qR" target="slowR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
