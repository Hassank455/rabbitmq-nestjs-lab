<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab02 Connections and Channels">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 02 — Connections, channels, and where prefetch lives" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Process 1 -->
        <mxCell id="p1" value="Node process #1   (PORT=3000, WORKER_NAME=W1)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="380" as="geometry" />
        </mxCell>
        <mxCell id="conn1" value="1 TCP connection  ·  amqp.connect()  ·  expensive" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fbf8fc;" vertex="1" parent="p1">
          <mxGeometry x="20" y="50" width="520" height="310" as="geometry" />
        </mxCell>
        <mxCell id="ch1" value="Channel 1 · shared · getChannel()" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontStyle=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="conn1">
          <mxGeometry x="20" y="50" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1c" value="Lab01Controller&lt;br&gt;&lt;i&gt;publish&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ch1">
          <mxGeometry x="15" y="45" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l2c" value="Lab02Controller&lt;br&gt;&lt;i&gt;publish&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ch1">
          <mxGeometry x="170" y="45" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l1s" value="Lab01Consumer&lt;br&gt;&lt;i&gt;consume&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ch1">
          <mxGeometry x="325" y="45" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="Channel 2 · own · createChannel() · prefetch(N)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="conn1">
          <mxGeometry x="20" y="180" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2s" value="&lt;b&gt;Lab02Consumer&lt;/b&gt;  ·  consume('tasks')  ·  the prefetch limit lives HERE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ch2">
          <mxGeometry x="20" y="45" width="440" height="50" as="geometry" />
        </mxCell>

        <!-- Process 2 -->
        <mxCell id="p2" value="Node process #2   (PORT=3001, WORKER_NAME=W2)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="560" height="240" as="geometry" />
        </mxCell>
        <mxCell id="conn2" value="its own TCP connection" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fbf8fc;" vertex="1" parent="p2">
          <mxGeometry x="20" y="50" width="520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ch3" value="its own channel · prefetch(N)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="conn2">
          <mxGeometry x="20" y="50" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2s" value="&lt;b&gt;Lab02Consumer&lt;/b&gt;  ·  consume('tasks')" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ch3">
          <mxGeometry x="20" y="38" width="440" height="48" as="geometry" />
        </mxCell>

        <!-- Broker -->
        <mxCell id="broker" value="RabbitMQ broker" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="380" height="680" as="geometry" />
        </mxCell>
        <mxCell id="qn" value="&lt;b&gt;Queue: notifications&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="70" y="120" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qt" value="&lt;b&gt;Queue: tasks&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="70" y="360" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bnote" value="&lt;b&gt;prefetch is per CHANNEL.&lt;/b&gt;&lt;br&gt;Process #1 and process #2 never share a limit, not even with global = true." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="broker">
          <mxGeometry x="20" y="550" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="E1" value="publish + consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4545;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch1" target="qn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="E2" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch1" target="qt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="268" />
              <mxPoint x="740" y="456" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="E3" value="consume · prefetch(N)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch2" target="qt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="365" />
              <mxPoint x="680" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="E4" value="consume · prefetch(N)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch3" target="qt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="670" />
              <mxPoint x="710" y="504" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="footer" value="&lt;b&gt;Rule:&lt;/b&gt; 1 connection per process (TCP is expensive)  ·  many channels on top of it (cheap)  ·  1 channel per consumer, so each consumer has its own prefetch and one channel error cannot kill the others." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1100" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
