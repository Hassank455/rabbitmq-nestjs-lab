  <diagram name="Lab02 Share vs Copy">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 02 — A queue SHARES. An exchange COPIES." style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Panel A -->
        <mxCell id="pA" value="A · ONE queue + 3 consumers → they SHARE the work" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
