          <mxGeometry x="350" y="330" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="txtA" value="&lt;b&gt;Processed: 6 in total.&lt;/b&gt;&lt;br&gt;Each message is HANDED OVER to exactly one worker." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="pA">
          <mxGeometry x="20" y="420" width="480" height="60" as="geometry" />
        </mxCell>

