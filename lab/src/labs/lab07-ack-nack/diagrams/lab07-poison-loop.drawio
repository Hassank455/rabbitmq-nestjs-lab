      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="title" value="One poison message, requeue: true, prefetch(1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1240" height="40" as="geometry" /></mxCell>
<mxCell id="ql" value="queue lab07.payments&lt;br&gt;← front is on the left" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="115" width="160" height="60" as="geometry" /></mxCell>
<mxCell id="q0" value="#1&lt;br&gt;poison" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="120" height="60" as="geometry" /></mxCell>
<mxCell id="q1" value="#2 ok" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="150" y="115" width="120" height="60" as="geometry" /></mxCell>
<mxCell id="q2" value="#3 ok" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="115" width="120" height="60" as="geometry" /></mxCell>
<mxCell id="q3" value="#4 ok" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="115" width="120" height="60" as="geometry" /></mxCell>
<mxCell id="cons" value="&lt;b&gt;consumer&lt;/b&gt;&lt;br&gt;prefetch(1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="115" width="220" height="60" as="geometry" /></mxCell>
<mxCell id="fail" value="handle() fails&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;nack(msg, false, true)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="115" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="d1" value="1. deliver the FRONT" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;html=1;fontSize=12;" edge="1" parent="1" source="q0" target="cons"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="215" /><mxPoint x="830" y="215" /></Array></mxGeometry></mxCell>
<mxCell id="d2" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;html=1;" edge="1" parent="1" source="cons" target="fail"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="d3" value="2. requeued to its ORIGINAL position = the front → go to 1" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;html=1;fontSize=12;" edge="1" parent="1" source="fail" target="q0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="85" /><mxPoint x="80" y="85" /></Array></mxGeometry></mxCell>
<mxCell id="log" value="&lt;b&gt;Measured log&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;#1 poison attempt=1 redelivered=false&lt;br&gt;↩️ #1 requeued&lt;br&gt;#1 poison attempt=2 redelivered=true&lt;br&gt;↩️ #1 requeued&lt;br&gt;…&lt;br&gt;#1 poison attempt=12 redelivered=true&lt;br&gt;&lt;br&gt;queue: Ready &lt;b&gt;3&lt;/b&gt; · Unacked &lt;b&gt;1&lt;/b&gt; — #2 #3 #4 never ran&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="610" height="180" as="geometry" /></mxCell>
<mxCell id="p10" value="&lt;b&gt;Same test with prefetch(10)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;#1 poison attempt=1&lt;br&gt;#2 ok · #3 ok · #4 ok  delivered together&lt;br&gt;✅ #2  ✅ #3  ✅ #4&lt;br&gt;#1 poison attempt=2, 3, 4 … still looping&lt;/font&gt;&lt;br&gt;&lt;br&gt;The loop is still there.&lt;br&gt;It just stops blocking the others." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="610" height="180" as="geometry" /></mxCell>
<mxCell id="bot" value="With LAB07_DELAY=0: &lt;b&gt;1,475 redeliveries in 3 seconds&lt;/b&gt;, one CPU core at 100%, no error in the log, queue depth frozen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;rounded=1;spacingLeft=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1240" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
