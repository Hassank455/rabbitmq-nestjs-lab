<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Lab05 Subscriptions">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Lab 05 — How LAB05_SUBSCRIPTIONS becomes queues and bindings" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1210" height="40" as="geometry" />
        </mxCell>

        <mxCell id="code" value="&lt;b&gt;lab05.constants.ts&lt;/b&gt;&lt;br&gt;&lt;br&gt;LAB05_SUBSCRIPTIONS = {&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;audit&lt;/b&gt;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;['#'],&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;orders&lt;/b&gt;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;['order.#'],&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;compliance&lt;/b&gt;: ['*.*.eu'],&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;payments&lt;/b&gt;:&amp;nbsp;&amp;nbsp;&amp;nbsp;['order.paid.*', 'payment.#'],&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;alerts&lt;/b&gt;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;['*.failed.*'],&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;KEY&lt;/font&gt; → service → queue &lt;b&gt;lab05.&amp;lt;key&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;VALUE&lt;/font&gt; → one bindQueue per pattern" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="420" height="290" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="&lt;b&gt;Lab05Consumer.onModuleInit()&lt;/b&gt;&lt;br&gt;&lt;br&gt;for &lt;b&gt;service&lt;/b&gt; of LAB05_ALL_SERVICES:&lt;br&gt;&amp;nbsp;&amp;nbsp;queue = lab05QueueFor(service)&lt;br&gt;&amp;nbsp;&amp;nbsp;createChannel()&lt;br&gt;&amp;nbsp;&amp;nbsp;assertExchange(ex, 'topic')&lt;br&gt;&amp;nbsp;&amp;nbsp;assertQueue(queue)&lt;br&gt;&amp;nbsp;&amp;nbsp;for &lt;b&gt;pattern&lt;/b&gt; of SUBSCRIPTIONS[service]:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;bindQueue(queue, ex, pattern)&lt;br&gt;&amp;nbsp;&amp;nbsp;consume(queue)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="420" height="240" as="geometry" />
        </mxCell>

        <mxCell id="broker" value="RabbitMQ broker  ·  what exists after startup" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="750" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ex" value="&lt;b&gt;lab05.events.topic&lt;/b&gt;&lt;br&gt;type: &lt;b&gt;topic&lt;/b&gt;&lt;br&gt;&lt;br&gt;matches word by word" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="broker">
          <mxGeometry x="25" y="230" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="qa" value="&lt;b&gt;lab05.audit&lt;/b&gt;&lt;br&gt;1 binding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="505" y="50" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qo" value="&lt;b&gt;lab05.orders&lt;/b&gt;&lt;br&gt;1 binding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="505" y="140" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qc" value="&lt;b&gt;lab05.compliance&lt;/b&gt;&lt;br&gt;1 binding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="505" y="230" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="qp" value="&lt;b&gt;lab05.payments&lt;/b&gt;&lt;br&gt;2 bindings&lt;br&gt;&lt;i&gt;both match? still ONE copy&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="505" y="320" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ql" value="&lt;b&gt;lab05.alerts&lt;/b&gt;&lt;br&gt;1 binding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="broker">
          <mxGeometry x="505" y="450" width="220" height="64" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="#" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="qa">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="order.#" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="qo">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="*.*.eu" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="qc">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="order.paid.*" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="qp">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="payment.#" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="qp">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="*.failed.*" style="html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Courier New;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="ql">
          <mxGeometry x="0.35" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;5 keys → 5 services → 5 queues.&amp;nbsp; 6 patterns → 6 bindings.&lt;/b&gt;&amp;nbsp; The publisher sees none of this: it only knows lab05.events.topic.&lt;br&gt;Each label on an arrow is a &lt;b&gt;binding key&lt;/b&gt; — the only place * and # are allowed. A published routing key is always concrete, e.g. order.paid.eu." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="1210" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
